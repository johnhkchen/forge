# Copy to .env (git-ignored). `just` loads it.

# RunPod: Settings -> API Keys. Needs read/write on Serverless.
RUNPOD_API_KEY=
# Set after `just endpoint` creates the TRELLIS.2 endpoint.
TRELLIS_ENDPOINT_ID=
# The network volume holding the weights (EU-RO-1).
RUNPOD_VOLUME_ID=
# The worker image, built by .github/workflows/worker.yml.
TRELLIS_IMAGE=ghcr.io/OWNER/trellis2-worker:latest
