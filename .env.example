# Copy to .env (git-ignored). `just` loads it.

# RunPod: Settings -> API Keys. Needs read+write on Serverless, Network Volumes
# and Templates, read on the GPU catalog, and permission to run endpoint jobs.
RUNPOD_API_KEY=
# Set after `just endpoint` creates the TRELLIS.2 endpoint.
TRELLIS_ENDPOINT_ID=
# The network volume that caches the weights (~17 GB, downloaded on first use).
RUNPOD_VOLUME_ID=
# The worker image, built by .github/workflows/worker.yml.
TRELLIS_IMAGE=ghcr.io/johnhkchen/trellis2-worker:latest
# Set after `just motion-endpoint` creates the MotionBricks endpoint.
MOTIONBRICKS_ENDPOINT_ID=
# The MotionBricks worker image, built by .github/workflows/motionbricks-worker.yml.
MOTIONBRICKS_IMAGE=ghcr.io/johnhkchen/motionbricks-worker:latest
# Only for `just video` (motion from a video). Set after `just gemx-endpoint` creates the GEM-X endpoint.
GEMX_ENDPOINT_ID=
# The GEM-X worker image, built by .github/workflows/gemx-worker.yml.
GEMX_IMAGE=ghcr.io/johnhkchen/gemx-worker:latest
