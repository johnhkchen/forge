# Marble worlds as World Labs hands them over (splats, collision mesh, panorama): big, and fetched with credits
world/marble/
evidence/marble/diorama/cut/

# Segments packed for an AI restyle and what comes back (scripts/video/omni.py): made from clips that stay on this Mac
/exports/
# Kimodo takes for the screen-test motions (requests and answers, every take); the kept ones are motion/library/<id>/
motion/library/.cache/
motion/library/.joined/

# The screen test's cache of the cast's outlines, and its Blender log (scripts/casting/screen.py, casting.py screen-3d)
casting/*/screen/.cast/
casting/*/screen/*.log

# Codex's full-size headshots stay on this Mac; git keeps a 1024-pixel JPEG of each (screen.py keep)
casting/*/headshots/full/
