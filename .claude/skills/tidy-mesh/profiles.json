{
  "hero": {
    "about": "Close-up renders and printing. Keeps the full detail, tidied and with its materials baked so a GLB carries them.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "decimate.py",
        {
          "target_triangles": 200000,
          "keep_original": false
        }
      ],
      [
        "bake.py",
        {
          "mode": "materials",
          "texture_size": 2048
        }
      ]
    ],
    "export": {
      "image_format": "AUTO",
      "draco": false
    }
  },
  "quads": {
    "about": "Keep modeling it. Clean quads in regular loops, denser where the shape curves, ready to edit or subdivide.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 16000,
          "adaptivity": 1.0
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 2048
        }
      ]
    ],
    "export": {
      "image_format": "AUTO",
      "draco": false
    }
  },
  "web": {
    "about": "Web pages and product viewers. Adaptive quads, 1024 textures with a normal map, compressed.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 8000,
          "adaptivity": 1.0
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 1024
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    }
  },
  "game": {
    "about": "Real-time games. A few thousand adaptive quads; the normal map carries the fine detail.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 4000,
          "adaptivity": 1.0
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 1024
        }
      ]
    ],
    "export": {
      "image_format": "AUTO",
      "draco": false
    }
  },
  "mobile": {
    "about": "Phones and AR. As light as it gets while keeping the silhouette.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 3000,
          "adaptivity": 1.0,
          "anisotropy": 0.3
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 512
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    }
  }
}
