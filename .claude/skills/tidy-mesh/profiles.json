{
  "hero": {
    "about": "Close-up renders and printing. Keeps the full detail, tidied and with its materials baked so a GLB carries them.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "decimate.py",
        {
          "target_triangles": 200000,
          "keep_original": false
        }
      ],
      [
        "bake.py",
        {
          "mode": "materials",
          "texture_size": 2048
        }
      ]
    ],
    "export": {
      "image_format": "AUTO",
      "draco": false
    }
  },
  "quads": {
    "about": "Keep modeling it. Clean quads in regular loops, denser where the shape curves, ready to edit or subdivide.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 16000,
          "adaptivity": 1.0
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 2048
        }
      ]
    ],
    "export": {
      "image_format": "AUTO",
      "draco": false
    }
  },
  "web": {
    "about": "Web pages and product viewers. Adaptive quads, 1024 textures with a normal map, compressed.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 8000,
          "adaptivity": 1.0
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 1024
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    }
  },
  "game": {
    "about": "Real-time games. A few thousand adaptive quads; the normal map carries the fine detail. WebP textures and Draco compression keep the download small.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 4000,
          "adaptivity": 1.0,
          "use_parts": false
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 1024
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    }
  },
  "mobile": {
    "about": "Phones and AR. As light as it gets while keeping the silhouette.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "autoremesher",
        {
          "quads": 3000,
          "adaptivity": 1.0,
          "anisotropy": 0.3,
          "use_parts": false
        }
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 512
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    }
  },
  "lowpoly": {
    "about": "Old-school real-time style, like early Warcraft: a few hundred triangles Claude blocks out from simple shapes, with the detail's color and soft shadows painted into one small texture.",
    "steps": [
      [
        "clean.py",
        {}
      ],
      [
        "blockout",
        {}
      ],
      [
        "bake.py",
        {
          "mode": "onto",
          "texture_size": 256,
          "maps": [
            "color",
            "metallic",
            "roughness"
          ],
          "ao": true,
          "roughness": 0.85
        }
      ]
    ],
    "export": {
      "image_format": "WEBP",
      "draco": true
    },
    "flat_colors": {
      "about": "Old-school real-time style with flat colors (think old RuneScape): Claude's block-out with one color per part and faceted shading, no texture at all.",
      "steps": [
        [
          "clean.py",
          {}
        ],
        [
          "blockout",
          {
            "keep_colors": true
          }
        ]
      ],
      "export": {
        "materials": false,
        "draco": true
      }
    }
  }
}
